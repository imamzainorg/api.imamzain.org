{
  "name": "api.imamzain.org",
  "version": "1.0.0",
  "description": "Prisma schema, migrations and seed scripts for ImamZain.org (the API itself is in worker/)",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prisma:pull": "prisma db pull",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate --generator client",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node -P tsconfig.base.json prisma/seed.ts",
    "prisma:seed-content": "ts-node -P tsconfig.base.json prisma/seed-content.ts",
    "prisma:link-book-parts": "ts-node -P tsconfig.base.json prisma/link-book-parts.ts",
    "prisma:attach-app-books": "ts-node -P tsconfig.base.json prisma/attach-app-books.ts",
    "prisma:purge-content": "ts-node -P tsconfig.base.json prisma/purge-content.ts",
    "prisma:hydrate-media": "ts-node -P tsconfig.base.json prisma/hydrate-media.ts",
    "prisma:diagnose": "ts-node -P tsconfig.base.json prisma/seed-diagnose.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "prisma generate --generator client && tsc --noEmit -p tsconfig.json"
  },
  "prisma": {
    "seed": "ts-node --project tsconfig.json prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "p-limit": "^3.1.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^25.6.0",
    "prettier": "^3.9.9",
    "prisma": "^6.19.3",
    "typescript": "^6.0.3",
    "ts-node": "^10.9.2"
  }
}
