# ── Database (Supabase) ─────────────────────────────────────────
# Two different endpoints, on purpose — do NOT point both at the same port.
#
#   DATABASE_URL → the TRANSACTION-mode pooler, port 6543. This is what the
#   running app uses. Transaction mode hands a connection back to the pool
#   after every statement, so hundreds of concurrent requests share a small
#   number of Postgres backends. `pgbouncer=true` disables prepared
#   statements, which transaction mode cannot support.
#
#   `connection_limit` caps how many connections ONE app instance opens.
#   Without it Prisma defaults to (num_cpus * 2 + 1), so a single container
#   on a multi-core host can exhaust a small pool by itself — and a second
#   instance (or a migration, or a psql session) then gets
#   "max clients reached". Keep it low and explicit.
#
#   DIRECT_URL → the SESSION-mode pooler, port 5432. Used only by
#   `prisma migrate` / `db pull`, which need a stable session and real
#   prepared statements. Supabase's true direct endpoint
#   (db.[project].supabase.co) is IPv6-only unless you buy the IPv4 add-on,
#   so the session pooler is the correct IPv4-safe substitute here.
#
# Pointing DATABASE_URL at 5432 "works" but silently gives you the worst of
# both: session-mode connection scarcity AND no prepared statements.
DATABASE_URL="postgresql://postgres.[project]:[password]@[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
DIRECT_URL="postgresql://postgres.[project]:[password]@[region].pooler.supabase.com:5432/postgres"

# ── Server ──────────────────────────────────────────────────────
NODE_ENV="development"
PORT=3000
LOG_LEVEL="info"

# ── JWT ─────────────────────────────────────────────────────────
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="24h"
BCRYPT_ROUNDS=12

# Seconds after a refresh token was rotated during which presenting it again
# is treated as a benign concurrent refresh (two tabs, a retried request)
# instead of theft — both callers get a valid token in the same session.
# Default 10, clamped to 0-60; 0 disables the grace (any reuse revokes that
# session's whole token family); blank/non-numeric falls back to the default.
# REFRESH_REUSE_GRACE_SECONDS=10

# Force-redirect flagged accounts to a change-password screen. Only the
# literal "true" turns it on. Once on, a user flagged must_change_password
# (set when an admin resets their password, cleared when they change it
# themselves) gets 403 PASSWORD_CHANGE_REQUIRED on every authenticated route
# except /auth/me, /auth/me/password, /auth/logout and /auth/refresh. Leave
# unset (off) until the CMS ships its change-password screen.
# ENFORCE_PASSWORD_CHANGE_AFTER_RESET=true

# ── Email (Hostinger SMTP) ──────────────────────────────────────
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_USER="info@imamzain.org"
SMTP_PASS="your-mailbox-password"
SMTP_SECURE=true
EMAIL_FROM="ImamZain.org <info@imamzain.org>"
# Where the admin notification digests (new contact messages / proxy-visit
# requests) go. The "notifications_email_to" site setting wins when set.
EMAIL_TO="info@imamzain.org"

# Admin notifications are BATCHED: form submissions are stored first and a cron
# sends one digest e-mail per burst, never one per submission. This is the
# minimum gap between two digests, in seconds (default 300; 0 = a digest every
# minute there is something new). Submissions the digest could not deliver stay
# queued and go out with the next one.
FORM_NOTIFY_MIN_INTERVAL_SECONDS=300

# Newsletter CAMPAIGN lane (optional). Bulk newsletter mail can use its own
# mailbox so a campaign cannot exhaust the shared mailbox's hourly quota
# (Hostinger allows ~100 messages/hour in TOTAL) that the digests and sign-up
# confirmations above depend on. Every value falls back to its SMTP_* /
# EMAIL_FROM counterpart, so you normally set only the mailbox. Leave commented
# out to send campaigns through the mailbox above (raise
# NEWSLETTER_SEND_PER_HOUR only when you have a dedicated one).
# CAMPAIGN_SMTP_USER="newsletter@imamzain.org"
# CAMPAIGN_SMTP_PASS="the-newsletter-mailbox-password"
# CAMPAIGN_SMTP_HOST=
# CAMPAIGN_SMTP_PORT=
# CAMPAIGN_SMTP_SECURE=
# CAMPAIGN_EMAIL_FROM="ImamZain Newsletter <newsletter@imamzain.org>"

# ── Twilio WhatsApp ─────────────────────────────────────────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
TWILIO_TEMPLATE_SID=""

# ── Cloudflare R2 ───────────────────────────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="imamzain-media"
R2_PUBLIC_BASE_URL="https://cdn.imamzain.org"
# Pre-signed upload URL lifetime for audio / PDF uploads (audios, books,
# academic papers). Image upload URLs (POST /media/upload-url) are always
# capped at min(this, 900) seconds — the pending-upload row's own lifetime —
# so a value above 900 has no effect on images. An unparsable value falls
# back to 900.
R2_UPLOAD_URL_TTL_SECONDS=900

# ── Sentry (production only) ────────────────────────────────────
SENTRY_DSN=""

# ── CORS ────────────────────────────────────────────────────────
# REQUIRED in production. Comma-separated list of explicit origins. Without
# this, the API refuses to boot in production rather than echoing the caller.
ALLOWED_ORIGINS="https://imamzain.org,https://cms.imamzain.com,https://app.imamzain.org"

# ── API docs (Scalar) ───────────────────────────────────────────
# "true" exposes /docs and /openapi.json publicly. Defaults to off in
# production to avoid leaking the full route surface to anonymous traffic.
EXPOSE_DOCS=""

# ── Newsletter ──────────────────────────────────────────────────
# Server-side secret used to HMAC the unsubscribe token in every campaign
# e-mail's unsubscribe link (and the confirmation links). Falls back to a key
# derived from JWT_SECRET (HKDF-SHA256, one purpose-scoped key per token type)
# when unset; set this explicitly if you ever want to rotate the unsubscribe
# key independently of JWT_SECRET. Verification still accepts tokens signed
# with the raw JWT_SECRET for links minted before this derivation shipped.
NEWSLETTER_UNSUBSCRIBE_SECRET=""

# Front-end unsubscribe page used to build {{unsubscribe_url}} substitution
# in outbound newsletter bodies. Defaults to https://imamzain.org/newsletter/unsubscribe.
NEWSLETTER_UNSUBSCRIBE_URL_BASE=""

# Double opt-in. Signing up sends a confirmation e-mail; the subscription only
# starts when its link is clicked. This is the website page the link points at
# (it must POST the link's ?email=&token= to /newsletter/confirm). Defaults to
# https://imamzain.org/newsletter/confirm.
NEWSLETTER_CONFIRM_URL_BASE=""

# Confirmation e-mails sent per rolling hour across ALL addresses (default 30).
# Beyond it a sign-up still gets its 200 but no mail is sent — this keeps a
# flood of fake sign-ups from eating the shared mailbox's quota.
NEWSLETTER_CONFIRM_MAX_PER_HOUR=30

# Campaign delivery budget: newsletter messages per rolling hour across ALL
# campaigns (default 300 — Hostinger's own published limit for the shared
# mailbox is 500/hour per mailbox+domain, and digests + confirmations need some
# of that headroom too; see docs/integration.md for the source and reasoning).
# A list of 1,300 therefore takes a bit over 4 hours; raise it further only if
# you use a dedicated CAMPAIGN_SMTP_* mailbox whose real limit is higher.
NEWSLETTER_SEND_PER_HOUR=300

# Most recipients one cron tick (every minute) may attempt (default 10). The
# hourly budget above still applies.
NEWSLETTER_BATCH_SIZE=10

# ── Contest ─────────────────────────────────────────────────────
# Secret used to HMAC contest attempt tokens. Falls back to a key derived
# from JWT_SECRET (HKDF-SHA256) when unset; set it explicitly if you ever
# want to rotate the contest signing key independently of JWT_SECRET.
# Verification still accepts tokens signed with the raw JWT_SECRET for
# attempts started before this derivation shipped.
CONTEST_ATTEMPT_SECRET=""

# Whether POST /submit tells the participant their score. Default (blank/true):
# yes. Set false for a contest with a prize: an instant score for an unverified
# identity lets someone open many identities, probe answers and work out the
# key. The score is still stored and shown to admins; the committee announces
# results itself, and the response carries final_score: null.
CONTEST_REVEAL_SCORE=""

# Per-IP ceiling on the contest's /start and /submit per 15 minutes (default
# 60). A classroom or event shares ONE NAT'd address, so keep it generous;
# raise it for a big event.
CONTEST_THROTTLE_PER_IP=60

# ── Seed (prisma:seed) ──────────────────────────────────────────
# Bootstrap super-admin credentials. If SEED_ADMIN_PASSWORD is unset, the
# seed skips user creation with a warning. Username defaults to "superadmin".
SEED_ADMIN_USERNAME=""
SEED_ADMIN_PASSWORD=""

# The seed is CREATE-ONLY for role grants: it gives a brand-new role its
# permissions and grants each brand-new permission to the roles that list it,
# but never re-adds a grant an admin removed. "true" restores the old behaviour
# (re-grant everything the seed lists to every role) for a deliberate reset.
SEED_RESET_ROLE_GRANTS=""

# ── Ops ─────────────────────────────────────────────────────────
# "true" disables all background cron ticks (newsletter sends, scheduled
# publishing, YouTube sync, cleanup jobs) for this process. Set automatically
# by the operator scripts (upload-missing-r2, reconcile-audios,
# backfill-media-variants) so maintenance runs never execute production ticks.
DISABLE_CRON=""

# ── Public site (sitemap + RSS) ─────────────────────────────────
# Base URL the API emits when generating sitemap.xml / rss/posts.xml entries.
# Defaults to https://imamzain.org if unset. Public-facing post URLs are
# built as `${PUBLIC_SITE_URL}/{lang}/posts/{slug}`.
PUBLIC_SITE_URL=""

# Title shown in the RSS <channel><title> element. Defaults to
# "Imam Zain Foundation".
PUBLIC_SITE_NAME=""

# IANA time zone name used as the calendar-day boundary for the daily hadith
# of the day (GET /daily-hadiths/today, GET /homepage). Defaults to
# "Asia/Baghdad". Unset, blank or invalid falls back to the default with a
# one-time boot warning. Set "UTC" to restore the old UTC-day behaviour.
# SITE_TIMEZONE="Asia/Baghdad"

# ── Redis (optional, multi-instance deployments) ────────────────
# When set, enables (a) a shared throttler counter across processes
# (otherwise each instance has its own bucket and the 1000/15min global
# ceiling effectively becomes 1000×N), and (b) pub/sub-driven JWT cache
# invalidation so a password change / admin reset on one instance clears
# the user's cached row on every other instance within milliseconds.
#
# Leave UNSET for single-instance prod and dev — both features fall back
# to in-process state with no behavioural difference at one instance.
#
# Format: redis://[username:password@]host:port[/db]
# TLS:    rediss://...
#
# If set but Redis is briefly unreachable, the API still boots; ioredis
# retries with exponential backoff and the affected features degrade
# gracefully until reconnection.
REDIS_URL=""

# ── Proxy / rate limiting ───────────────────────────────────────
# How many proxy hops to trust when reading the client IP from
# X-Forwarded-For. Render's load balancer alone = 1 (default). With the
# project's Cloudflare zone proxying api.imamzain.org in front of Render
# = 2 — with 1, per-IP throttles and audit_logs.ip_address key on the
# Cloudflare edge address, not the visitor. A container reachable directly
# (no proxy) must use 0 or a spoofed X-Forwarded-For header is trusted.
TRUST_PROXY_HOPS=1

# API-wide ceiling per client IP per 15 minutes, on top of the per-route
# buckets (login 10, forms 300/h, …). Defaults to 3000. Set 0 to disable the
# global bucket (per-route limits still apply). Raise it if a server-side
# caller (SSR, a crawler you run) legitimately exceeds ~3 req/s from one IP.
THROTTLE_GLOBAL_LIMIT=3000

# ── YouTube Data API ─────────────────────────────────────────────
# Powers the local YouTube mirror that the public /youtube/* endpoints
# and the homepage aggregator read from. A background cron syncs the
# channel's videos + playlists every 6 hours. If unset, sync is skipped
# silently — the homepage just returns an empty videos array.
#
# Get a key from console.cloud.google.com → enable "YouTube Data API
# v3" → restrict the key to that one API for safety. Quota is generous
# (10k units/day default); the sync uses ~10–20 units per run, so a
# tight margin is fine.
YOUTUBE_API_KEY=""
YOUTUBE_CHANNEL_ID=""
