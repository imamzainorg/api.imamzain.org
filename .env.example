# ── Database (Supabase) ─────────────────────────────────────────
# Two different endpoints, on purpose — do NOT point both at the same port.
#
#   DATABASE_URL → the TRANSACTION-mode pooler, port 6543. This is what the
#   running app uses. Transaction mode hands a connection back to the pool
#   after every statement, so hundreds of concurrent requests share a small
#   number of Postgres backends. `pgbouncer=true` disables prepared
#   statements, which transaction mode cannot support.
#
#   `connection_limit` caps how many connections ONE app instance opens.
#   Without it Prisma defaults to (num_cpus * 2 + 1), so a single container
#   on a multi-core host can exhaust a small pool by itself — and a second
#   instance (or a migration, or a psql session) then gets
#   "max clients reached". Keep it low and explicit.
#
#   DIRECT_URL → the SESSION-mode pooler, port 5432. Used only by
#   `prisma migrate` / `db pull`, which need a stable session and real
#   prepared statements. Supabase's true direct endpoint
#   (db.[project].supabase.co) is IPv6-only unless you buy the IPv4 add-on,
#   so the session pooler is the correct IPv4-safe substitute here.
#
# Pointing DATABASE_URL at 5432 "works" but silently gives you the worst of
# both: session-mode connection scarcity AND no prepared statements.
DATABASE_URL="postgresql://postgres.[project]:[password]@[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
DIRECT_URL="postgresql://postgres.[project]:[password]@[region].pooler.supabase.com:5432/postgres"

# ── Seed (prisma:seed) ──────────────────────────────────────────
# Bootstrap super-admin credentials. If SEED_ADMIN_PASSWORD is unset, the
# seed skips user creation with a warning. Username defaults to "superadmin".
SEED_ADMIN_USERNAME=""
SEED_ADMIN_PASSWORD=""
BCRYPT_ROUNDS=12

# The seed is CREATE-ONLY for role grants: it gives a brand-new role its
# permissions and grants each brand-new permission to the roles that list it,
# but never re-adds a grant an admin removed. "true" re-grants everything the
# seed lists to every role, for a deliberate reset.
SEED_RESET_ROLE_GRANTS=""

# This file only configures Prisma (migrations) and the prisma/ scripts. The API's own settings and
# secrets live in worker/wrangler.jsonc, `wrangler secret put` and worker/.dev.vars.
