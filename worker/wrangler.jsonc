// Hono API Worker for api.imamzain.org (docs/HONO-MIGRATION-PLAN.md). Phase 6: Nest is gone, every route is served here.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "imamzain-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // Route on the zone, not a Custom Domain. Server-side callers in the same zone (the website Worker, any
  // CMS Worker) must reach the API through a Service Binding: a fetch() to this route from another Worker
  // in the zone skips it.
  "routes": [{ "pattern": "api.imamzain.org/*", "zone_name": "imamzain.org" }],
  "workers_dev": false,
  "observability": { "enabled": true },

  // D9: Smart Placement never placed at our traffic (Phase 1 check 6); pin next to Supabase.
  "placement": { "region": "aws:eu-north-1" },

  // Caching is off on this config (stale reads would reach the CMS). Its origin connection
  // limit must stay at 5 while Supavisor's session pool is 15 (Phase 1 check 1).
  // localConnectionString is what `wrangler dev` uses: the same DB as .env.test.example.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "c81bd672682b4d7c8ee2661b0d0f7f08",
      "localConnectionString": "postgresql://postgres:postgres@localhost:5432/imamzain_test"
    }
  ],

  "r2_buckets": [{ "binding": "R2", "bucket_name": "imamzain-media" }],

  "images": { "binding": "IMAGES" },

  // The Hijri date's anchor (src/features/daily-hadiths/hijri-date.ts): one key, rewritten only when
  // sistani.org is read. Local `wrangler dev` uses a local namespace.
  "kv_namespaces": [{ "binding": "HIJRI_DATE_ANCHOR", "id": "6f9ad852d7694feea20b0f1e512590a0" }],

  // D1: Cloudflare Email Service (imamzain.org is onboarded for sending). Local `wrangler dev` simulates it
  // and sends nothing; the sender address must be on the onboarded domain.
  "send_email": [{ "name": "EMAIL" }],

  // Cron jobs (src/jobs/index.ts, CRONS). Cron Triggers run in UTC, as Nest's did on Render.
  "triggers": {
    "crons": [
      "* * * * *",   // scheduled post publish, form notification outbox
      "0 * * * *",   // orphan-upload cleanup; Hijri date check; YouTube sync when the UTC hour is a multiple of 6
      "15 3 * * *"   // refresh-token, login-attempt and audit-log retention
    ]
  },

  // D6: the binding only has 10 s / 60 s windows and a fixed limit, so there is one binding
  // per limit tier. Nest's 15-min and 1-h limits are mapped onto these by the rate-limit
  // helper (Phase 2 task 2). namespace_id must be unique per Cloudflare account.
  "ratelimits": [
    // Nest's API-wide ceiling: 3,000 / 15 min per IP.
    { "name": "RL_GLOBAL", "namespace_id": "1001", "simple": { "limit": 200, "period": 60 } },
    { "name": "RL_120", "namespace_id": "1007", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_60", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
    { "name": "RL_30", "namespace_id": "1003", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_20", "namespace_id": "1008", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_10", "namespace_id": "1004", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_5", "namespace_id": "1005", "simple": { "limit": 5, "period": 60 } },
    // D7: view dedup, keyed on `ip:resource`.
    { "name": "RL_VIEW", "namespace_id": "1006", "simple": { "limit": 1, "period": 60 } }
  ],

  "vars": {
    "ALLOWED_ORIGINS": "https://imamzain.org,https://cms.imamzain.com,https://app.imamzain.org",
    "R2_PUBLIC_BASE_URL": "https://cdn.imamzain.org",
    "EMAIL_FROM": "imamzain.org <info@imamzain.org>"
  }

  // Secrets: set with `npx wrangler secret put <NAME>`, or in .dev.vars for `wrangler dev`.
  // Never put them in this file. Same names and values as the Nest env:
  //   JWT_SECRET
  //   JWT_EXPIRES_IN, BCRYPT_ROUNDS, REFRESH_REUSE_GRACE_SECONDS, ENFORCE_PASSWORD_CHANGE_AFTER_RESET   (only if set on Nest; same defaults otherwise)
  //   YOUTUBE_CHANNEL_ID   (the homepage lists only this channel's uploads; unset lists every mirrored video)
  //   YOUTUBE_API_KEY   (the 6-hourly sync; unset skips it)
  //   PUBLIC_SITE_URL, PUBLIC_SITE_NAME   (sitemap / RSS; only if set on Nest, else the same defaults apply)
  //   HIJRI_SOURCE_URL   (the page the Hijri date is read from; unset reads https://www.sistani.org/)
  //   R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY   (aws4fetch presigned PUTs)
  //   TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_WHATSAPP_FROM, TWILIO_TEMPLATE_SID
  //   NEWSLETTER_UNSUBSCRIBE_SECRET, CONTEST_ATTEMPT_SECRET, CONTEST_REVEAL_SCORE   (only if set on Nest)
  //   EMAIL_TO, FORM_NOTIFY_MIN_INTERVAL_SECONDS, NEWSLETTER_CONFIRM_URL_BASE, NEWSLETTER_UNSUBSCRIBE_URL_BASE, NEWSLETTER_CONFIRM_MAX_PER_HOUR   (only if set on Nest; same defaults otherwise)
}
