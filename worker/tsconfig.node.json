{
  // Node-side test code: the contract harness and suite and its runners. tsconfig.json covers the
  // Worker itself (workerd types); the two type worlds don't mix.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["test/harness", "test/contract", "vitest.config.ts", "vitest.contract.config.ts"]
}
