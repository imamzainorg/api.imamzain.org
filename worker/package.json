{
  "name": "imamzain-api-worker",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "gen": "prisma generate --schema ../prisma/schema.prisma --generator worker && wrangler types",
    "dev": "npm run gen && wrangler dev",
    "deploy": "npm run gen && wrangler deploy",
    "typecheck": "npm run gen && tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "contract": "tsx test/contract/run.ts",
    "diff": "tsx test/diff/run.ts",
    "check": "tsx test/check.ts",
    "check:health": "tsx test/check.ts health",
    "check:post-categories": "tsx test/check.ts post-categories",
    "check:book-categories": "tsx test/check.ts book-categories",
    "check:gallery-categories": "tsx test/check.ts gallery-categories",
    "check:academic-paper-categories": "tsx test/check.ts academic-paper-categories",
    "check:languages": "tsx test/check.ts languages",
    "check:settings": "tsx test/check.ts settings",
    "check:speakers": "tsx test/check.ts speakers",
    "check:stores": "tsx test/check.ts stores",
    "check:static-pages": "tsx test/check.ts static-pages",
    "check:gallery": "tsx test/check.ts gallery",
    "check:audios": "tsx test/check.ts audios",
    "check:academic-papers": "tsx test/check.ts academic-papers",
    "check:books": "tsx test/check.ts books",
    "check:posts": "tsx test/check.ts posts",
    "check:daily-hadiths": "tsx test/check.ts daily-hadiths"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "6.19.3",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "sanitize-html": "2.17.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.2",
    "prisma": "6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  }
}
