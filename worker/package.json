{
  "name": "imamzain-api-worker",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "gen": "prisma generate --schema ../prisma/schema.prisma --generator worker && wrangler types",
    "dev": "npm run gen && wrangler dev",
    "deploy": "npm run gen && wrangler deploy",
    "typecheck": "npm run gen && tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "contract": "tsx test/contract/run.ts"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "6.19.3",
    "aws4fetch": "^1.0.20",
    "bcryptjs": "^3.0.3",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "sanitize-html": "2.17.5",
    "validator": "^13.15.35",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.2",
    "@types/validator": "^13.15.10",
    "prisma": "6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  }
}
