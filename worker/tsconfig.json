{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["./worker-configuration.d.ts"],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["src", "test", "worker-configuration.d.ts"],
  // Node-side test code: tsconfig.node.json.
  "exclude": ["test/harness", "test/diff", "test/contract", "test/check.ts"]
}
